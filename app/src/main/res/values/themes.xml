<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.ChargeGuard" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/cg_background</item>
        <item name="android:colorBackground">@color/cg_background</item>
        <item name="android:colorAccent">@color/cg_green</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">@color/cg_background</item>
    </style>

    <style name="Theme.ChargeGuard.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/cg_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.ChargeGuard</item>
    </style>
</resources>
